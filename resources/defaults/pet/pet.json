{
  "version": 1,
  "description": "一个图片就是一个完整宠物；采用 4x4 常规切块，每行一种状态，每列一帧。",
  "sprite": {
    "columns": 4,
    "rows": 4,
    "totalFrames": 16,
    "frameWidth": 256,
    "frameHeight": 256,
    "rowStates": [
      {
        "row": 0,
        "state": "idle",
        "label": "空闲",
        "frames": [
          0,
          1,
          2,
          3
        ],
        "fps": 4
      },
      {
        "row": 1,
        "state": "active",
        "label": "活跃",
        "frames": [
          4,
          5,
          6,
          7
        ],
        "fps": 6
      },
      {
        "row": 2,
        "state": "hover",
        "label": "悬停",
        "frames": [
          8,
          9,
          10,
          11
        ],
        "fps": 5
      },
      {
        "row": 3,
        "state": "detached",
        "label": "拖出窗口",
        "frames": [
          12,
          13,
          14,
          15
        ],
        "fps": 6
      }
    ]
  }
}
